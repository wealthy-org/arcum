{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vol-engine": {
      "root": "vol-engine",
      "runtime": "python",
      "entrypoint": "api/index.py"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/vol/(.*)",
      "destination": {
        "service": "vol-engine"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
