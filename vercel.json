{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vol-engine": {
      "root": "vol-engine",
      "runtime": "python"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "vol-engine",
          "format": "url",
          "env": "VOL_ENGINE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/vol/(.*)",
      "destination": {
        "service": "vol-engine"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
