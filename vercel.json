{
  "framework": "vite",
  "buildCommand": "cd web && bun run build",
  "outputDirectory": "web/dist",
  "installCommand": "cd web && bun install",
  "rewrites": [
    {
      "source": "/api/rpc-mainnet",
      "destination": "https://rpc.mainnet.chain.robinhood.com"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
