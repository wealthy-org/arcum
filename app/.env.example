# Arcum backend services — environment template
#
# Copy to `.env` (Bun loads it automatically) and fill in. `.env` is gitignored.
# NEVER commit a real key, and never reuse the owner/deployer key for a service.

# --- Keeper (src/keeper/run.ts) ------------------------------------------------------
# Required. There is no fallback: without this the process throws on load instead of
# starting with a placeholder key that silently does nothing (or signs the wrong tx).
# Use a dedicated hot key that holds only gas, and never the owner, deployer, or vol
# publisher key. It only calls `accrueMany`, so it needs no protocol role beyond gas.
KEEPER_PRIVATE_KEY=

# Testnet RPC used by the keeper. Defaults to the public endpoint.
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# The keeper is off unless you ask for it. `tick()` is exported so tests can call it once.
RUN_KEEPER_DAEMON=false

# Tick interval. Default 3600000 (1 hour). Shorter does not make accrual more accurate:
# funding is linear in elapsed time, so a 15-minute loop just pays gas four times as often.
KEEPER_INTERVAL_MS=3600000

# Log the series that would be accrued, sign nothing. Use this before a first live run.
KEEPER_DRY_RUN=false

# --- Volatility publisher (vol-engine/publish_once.py) --------------------------------
# The publisher reuses KEEPER_PRIVATE_KEY above; it must be an allowlisted isPublisher on
# VolOracle. These are deployment facts, not secrets: stock token addresses on the chain.
VOL_ORACLE_ADDRESS=0x09f2B03288A72C5B6F31B9Db19548aca42116B81
STOCK_NVDA=0x98a7b951482601E825dC5609A2224e0677f9101D
STOCK_AAPL=0xb5c3A000832ab1D13A8a6a33ba49696163d49379
STOCK_QQQ=0xd5F42ad1Ace31Ac95F31DAdeEd727C5c8A21f110

# --- API server (src/api/server.ts) --------------------------------------------------
PORT=3002
