# Arcum — production deploy inputs (Robinhood Chain Mainnet, chainId 4663)
#
# Usage:
#   cp .env.production.example .env.production
#   # fill PRIVATE_KEY + OWNER_ADDRESS, then:
#   set -a && source .env.production && set +a
#   forge script script/DeployProduction.s.sol:DeployProduction \
#       --rpc-url $MAINNET_RPC --broadcast --slow
#
# Always run once with DRY_RUN=true first: it validates every input on-chain and deploys nothing.
# NEVER commit the filled .env.production (it is gitignored).

MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# Deployer key. Must be a key that was never pasted into chat/tickets/screenshots.
# The legacy deployer 0x1B4Faa130Aa607Fce29F9AAd6120b4492DE93e45 is COMPROMISED — staging only.
# Mode A (raw key, local only, delete the line after the broadcast):
PRIVATE_KEY=
# Mode B (Foundry encrypted keystore — recommended): leave PRIVATE_KEY empty, set the address here and run
#   cast wallet import arcum-deployer --interactive
#   forge script script/DeployProduction.s.sol:DeployProduction --account arcum-deployer --sender $DEPLOYER_ADDRESS ...
DEPLOYER_ADDRESS=

# Escape hatch only: lets an EOA be the owner. Does NOT bypass the compromised-deployer check.
ALLOW_EOA_OWNER=false

# Final owner of every contract (engine/registry/guard/feeRouter + pool admin).
# MUST be a Safe multisig or a fresh single-key wallet. NOT the deployer EOA.
OWNER_ADDRESS=

# Settlement token: USDG (Global Dollar). Verified on-chain: symbol "USDG", decimals 6.
# Source: docs/CHAIN_FACTS.md (read from chain, not from a chat message).
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- Stock tokens + Chainlink AggregatorV3 feeds (verified on-chain) -----------------
# Only these three have a Chainlink feed on 4663. TSLA and SPY are NOT listed yet,
# so they cannot be part of a production launch.
STOCK_SYMBOLS=NVDA,AAPL,QQQ
STOCK_NVDA=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
STOCK_AAPL=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9
STOCK_QQQ=0xD5f3879160bc7c32ebb4dC785F8a4F505888de68
FEED_NVDA=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
FEED_AAPL=0x6B22A786bAa607d76728168703a39Ea9C99f2cD0
FEED_QQQ=0x80901d846d5D7B030F26B480776EE3b29374C2ae

# --- Series to list at deploy time --------------------------------------------------
# Format: SYMBOL:call|put:strikeInWholeDollars:tauSeconds ; separated by ';'
# Strikes are expressed in whole dollars (script scales by 1e18).
SERIES_SPECS=NVDA:call:155:86400;AAPL:call:355:86400;QQQ:call:655:86400

# --- Oracle guard parameters ---------------------------------------------------------
# Staleness windows, in seconds, applied per market session by `PriceGuardProd._maxAge`:
#   REGULAR  -> maxAgeRegular   (09:30-16:00 ET)
#   EXTENDED -> maxAgeExtended  (04:00-09:30 and 16:00-20:00 ET)
#   CLOSED   -> MAX_AGE_CLOSED, a constant 3 days. cfg.maxAgeRegular is NOT consulted when the market is closed.
#
# This used to be 90000 (25h) for both, justified as "equity feeds heartbeat at 86400s". That justification does not
# hold inside a live session: measured on 4663, the feeds had updated 1.8h (NVDA/AAPL) and 6h (QQQ) before the sample
# block, and a 25h window would have called those answers fresh and traded on them. Because CLOSED already has its own
# 3-day window, the 90000 value bought nothing for weekends - it only loosened the window that matters, during the
# session where prices actually move.
#
# 300s (5 min) regular is the shipped default here. Before launch, re-measure the real update cadence per feed during
# a live session and tighten or relax from evidence, not from an assumed heartbeat:
#   cast call $FEED "latestRoundData()(uint80,int256,uint256,uint256,uint80)" --rpc-url $RPC
# The regression lock for this is test/PriceGuardChainlink.t.sol::test_hazard_maxAgeRegular90000AcceptsSixHourOldPrice.
MAX_AGE_REGULAR=300
MAX_AGE_EXTENDED=900
CONTINUITY_BPS=0

# TWAP cross-check: leave empty unless a real Uniswap V3 pool exists for USDG/stock on 4663.
TWAP_REFERENCE=
TWAP_FEE=3000
TWAP_BAND_BPS=200

# --- WriterPool economics -------------------------------------------------------------
POOL_LOCK_SECONDS=259200
POOL_CASH_BUFFER_BPS=1000
POOL_MAX_SLIPPAGE_BPS=100
# 0 = no cap. Set an explicit cap (in USDG base units, 6 decimals) for production.
POOL_MAX_TOTAL_DEPOSITS=0
POOL_PUBLIC_DEPOSITS=true

# --- Vol oracle (IV input for the engine) ------------------------------------------
# The engine prices on a keeper-posted composite IV. Without a fresh reading inside these
# bounds the engine reverts StaleVol and buys stop — fail closed, by design.
VOL_MIN_SIGMA_BPS=500
VOL_MAX_SIGMA_BPS=30000
VOL_MAX_AGE=7200
VOL_MIN_TTL=60

# --- Caveat closure (script/CloseCaveats.s.sol) --------------------------------------
# Deploys the timelock, wires VolOracle + KeeperTwapReference, the ERC-4337 account factory
# and paymaster, and raises the timelock delay. Everything happens inside one contract
# constructor, so the whole closure is a single transaction.

# One-time keeper account, separate from owner and deployer. Receives the keeper role on the
# TWAP reference only; it must NOT be the owner, the deployer, or a key that has been in a chat.
KEEPER_ADDRESS=

# Timelock roles. Default to the deployer for bootstrap, then hand them to the Safe.
# Leaving them at the deployer means the deployer can propose/execute forever — fill these.
TL_PROPOSER=
TL_EXECUTOR=

# 0 for the bootstrap proposal only: the delay is raised to TL_FINAL_DELAY in the same tx,
# executed through the timelock itself, so the raised value governs every later proposal.
TL_INITIAL_DELAY=0
TL_FINAL_DELAY=172800

# TWAP reference averaging window and rate limit (seconds).
TWAP_WINDOW=3600
TWAP_MIN_INTERVAL=300

# ERC-4337 v0.7 canonical EntryPoint singleton.
AA_ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ERC-4337 keep this at 0. Any non-zero deposit is locked behind the paymaster owner, which
# is the 48h timelock, so funding it later needs a full timelock proposal. Fund on demand.
AA_PAYMASTER_DEPOSIT=0

# Vol reading publisher (run from vol-engine/, not from this script).
# The publisher address is allow-listed on-chain with setPublisher(address,true); there is no
# EIP-712 signature and no nonce — see vol-engine/README.md.
#   VOL_ENGINE_RPC=$MAINNET_RPC
#   VOL_ORACLE_ADDRESS=<written by CloseCaveats to deployments/4663-caveats.json>
#   VOL_PUBLISHER_PRIVATE_KEY=<publisher key, never the owner key>

# true only after you have confirmed OWNER_ADDRESS can sign (hands over admin irreversibly).
RENOUNCE_DEPLOYER=false
WRITE_MANIFEST=true
